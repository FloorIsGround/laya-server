[Unit]
Description=Laya internal inference API
Documentation=file:%h/laya-server/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/laya-server
EnvironmentFile=%h/laya-server/.env
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=USE_TF=0
Environment=USE_TORCH=1
ExecStart=%h/laya-server/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStartSec=600
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=default.target
